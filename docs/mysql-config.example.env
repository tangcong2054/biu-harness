# sqlite=本地旧后端；dual=SQLite 主写并镜像；mysql=Online 直接使用 MySQL。
BIU_STORAGE_BACKEND=mysql
BIU_MYSQL_URL=mysql://biu_app:replace-me@127.0.0.1:3306
BIU_MYSQL_DATABASE=biu_dev
BIU_OPS_MYSQL_DATABASE=biu_ops_dev
BIU_MYSQL_POOL_SIZE=10
BIU_MYSQL_SHADOW_DEBOUNCE_MS=750
# Online dual：mysql=Session 直接读写 MySQL；shadow=SQLite 主写后写 MySQL；sqlite=仍只用 SQLite。
BIU_SESSION_MYSQL_MODE=mysql
BIU_ACCOUNT_MYSQL_MODE=mysql
BIU_PAGE_MYSQL_MODE=mysql
BIU_TASK_MYSQL_MODE=mysql
BIU_EDITOR_CONTENT_MYSQL_MODE=mysql
BIU_METADATA_MYSQL_MODE=mysql
# Page 元数据与正文可分别灰度；Offline 会无条件回退 SQLite。
BIU_PAGE_MYSQL_MODE=mysql
BIU_TASK_MYSQL_MODE=mysql
BIU_EDITOR_CONTENT_MYSQL_MODE=mysql
# File System 元数据（Facet/View/Share/附件引用/PageBlock 索引）统一选择。
BIU_METADATA_MYSQL_MODE=mysql
# report：只登记无租户历史记录；discard：导入后从 MySQL 剔除，源 SQLite 不变。
BIU_MYSQL_OWNERLESS=discard

# 下列开关只在手工执行对应命令时临时设置，不应长期放在生产环境。
# BIU_MYSQL_RUN_MIGRATIONS=1
# BIU_MYSQL_IMPORT_MAIN=1
# BIU_MYSQL_IMPORT_OPS=1
# BIU_CREATE_BRANCH_SNAPSHOTS=1
